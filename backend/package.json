{
  "name": "banksphere-backend",
  "version": "1.0.0",
  "private": true,
  "description": "BankSphere Backend API",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
